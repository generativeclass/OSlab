
#include<stdio.h> 
#include<string.h> 
#include<sys/ipc.h> 
#include<sys/shm.h> 
#include<sys/types.h> 

int main() 
{ 
    key_t key; 
    int shmid; 
    void *ptr; 
    
    // Generate a unique key for shared memory
    key = ftok("shmfile", 'A'); 
    
    // Create a shared memory segment with a size of 1024 bytes
    shmid = shmget(key, 1024, 0666 | IPC_CREAT); 
    
    // Attach the shared memory to the process's address space
    ptr = shmat(shmid, (void *)0, 0); 
    
    // Input data to write to shared memory
    printf("\nInput Data : "); 
    fgets(ptr, 1024, stdin);
    
    // Detach the shared memory segment from the process's address space
    shmdt(ptr); 
    
    return 0; 
}

#include<stdlib.h>
#include<unistd.h>
#include<sys/types.h>
#include<sys/ipc.h>
#include<sys/msg.h>
#include<string.h>
#include<fcntl.h>
#include<sys/shm.h>
#include<stdio.h>
int main()
{
    key_t key;
    int shmid;
    void *ptr;
    
    // Generate a unique key for shared memory
    key = ftok("shmfile", 'A');
    
    // Access the shared memory segment created by the writer
    shmid = shmget(key, 1024, 0666 | IPC_CREAT);
    
    // Attach the shared memory segment to the reader's address space
    ptr = shmat(shmid, (void *)0, 0);
    
    // Read and print data from shared memory
    printf("Data stored: %s", (char *)ptr);
    
    // Detach the shared memory segment
    shmdt(ptr);
    
    // Remove the shared memory segment
    shmctl(shmid, IPC_RMID, NULL);
    
    return 0;
}
