#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int pid;          // Process ID
    int burstTime;    // Burst Time
    int arrivalTime;  // Arrival Time
    int startTime;    // Start Time
    int completionTime; // Completion Time
    int waitingTime;  // Waiting Time
    int turnaroundTime; // Turnaround Time
} Process;

// Comparator function to sort processes by burst time
int comp(const void *a, const void *b) {
    Process *processA = (Process *)a;
    Process *processB = (Process *)b;
    return processA->burstTime - processB->burstTime; // SJF: sort by burst time
}

int main() {
    int n;

    // Taking input
    printf("Enter the number of processes: ");
    scanf("%d", &n);

    
    Process *processes = malloc(n * sizeof(Process));

    printf("Enter Burst Time and Arrival Time for each process:\n");
    for (int i = 0; i < n; i++) {
        processes[i].pid = i + 1;  // Assign process ID
        printf("P%d - Burst Time: ", i + 1);
        scanf("%d", &processes[i].burstTime);
        printf("P%d - Arrival Time: ", i + 1);
        scanf("%d", &processes[i].arrivalTime);
    }

    // Sorting processes by burst time (SJF)
    qsort(processes, n, sizeof(Process), comp);

    int curr_time = 0;
    for (int i = 0; i < n; i++) {
        // Ensure current time is at least the arrival time of the process
        if (curr_time < processes[i].arrivalTime) {
            curr_time = processes[i].arrivalTime;
        }

        // Start Time of the process
        processes[i].startTime = curr_time;
        
        // Completion Time
        curr_time += processes[i].burstTime;
        processes[i].completionTime = curr_time;
        
        // Turnaround Time (Completion Time - Arrival Time)
        processes[i].turnaroundTime = processes[i].completionTime - processes[i].arrivalTime;
        
        // Waiting Time (Turnaround Time - Burst Time)
        processes[i].waitingTime = processes[i].turnaroundTime - processes[i].burstTime;
    }

    // Output results in a tabular form
    printf("\nPID\tBT\tAT\tST\tCT\tTAT\tWT\n");
    for (int i = 0; i < n; i++) {
        printf("%d\t%d\t%d\t%d\t%d\t%d\t%d\n", 
                processes[i].pid, 
                processes[i].burstTime, 
                processes[i].arrivalTime, 
                processes[i].startTime, 
                processes[i].completionTime, 
                processes[i].turnaroundTime, 
                processes[i].waitingTime);
    }

    return 0;
}
